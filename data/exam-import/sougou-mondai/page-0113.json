    {
      "type": "heading",
      "level": 3,
      "jp": "(4) 簡潔・丁寧に記述すること",
      "vi": "(4) Mô tả ngắn gọn, cẩn thận",
      "explanation_vi": null,
      "furigana_tokens": [
        { "surface": "簡潔", "reading": "かんけつ" },
